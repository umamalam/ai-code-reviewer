# Gemini API key -- https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_KEY=

# GitHub Personal Access Token (classic) with "repo" scope, used to read PR
# diffs and post review comments. Settings > Developer settings > Personal
# access tokens.
GITHUB_TOKEN=

# Any long random string. Must match EXACTLY what you enter as the "Secret"
# when creating the webhook in your repo's Settings > Webhooks.
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
